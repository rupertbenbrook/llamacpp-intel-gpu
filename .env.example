# Copy to .env. The defaults in compose.yml run the 9B Q4_K_M GGUF.
HF_MODEL=empero-ai/Qwen3.8-9B-Distill-GGUF:Q4_K_M
MODEL_ALIAS=qwen3.8-9b
CTX_SIZE=131072
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
GPU_LAYERS=auto
# For the 35B MoE experiment only (slow when its expert weights spill to the CPU):
# HF_MODEL=empero-ai/Qwen3.8-35B-A3B-Distill-GGUF:Q4_K_M
# MODEL_ALIAS=qwen3.8-35b-a3b
# CTX_SIZE=131072
# EXTRA_ARGS=--fit-target 3072
